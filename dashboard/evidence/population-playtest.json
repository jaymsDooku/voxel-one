  "steps": [
    {
      "step": "Technical college attendance",
      "setup": "Synthetic 21-year-old secondary graduate inside a technical college at 08:00; prior study 2.99 school years",
      "action": "Advance production simulation in 0.11-second calls; inspect school and citizen HUD",
      "expected": "Study rises only while physically attending; 3 school years yields TECHNICAL and factory eligibility",
      "observed": "Attendance rises, school occupancy is 1 / 8, then TECHNICAL graduation clears enrollment and shows factory careers"
    },
    {
      "step": "Primary, secondary and university graduation",
      "setup": "Synthetic students near graduation, ages 11, 17 and 21, with the required previous qualification",
      "action": "Advance a tick and inspect saved citizen state; render university graduate",
      "expected": "PRIMARY, SECONDARY and UNIVERSITY; university citizen joins graduate office labour pool",
      "observed": "All three qualifications granted; university citizen is in the graduate pool and HUD shows office careers"
    },
    {
      "step": "Family and aging",
      "setup": "Two unrelated age-19 adults share a home with spare capacity",
      "action": "Advance two ticks; inspect newborn; serialize and reload; advance again",
      "expected": "Reciprocal spouse links; one child with mother, father and shared home; no child job; saved cooldown prevents repeat birth",
      "observed": "Three residents; reciprocal spouse links; newborn has parent IDs 1 and 2, shared home, age 0 and no job; later age increases; reload preserves history"
    },
    {
      "step": "Family edges",
      "action": "Run minor, homeless, sibling, cooldown and invalid-spouse cases",
      "expected": "No minor marriage, no homeless birth, no sibling or parent pairing, next birth only after two years, invalid references rejected",
      "observed": "All assertions passed in the native playtest; advancing parental age by two years permits the second birth"
    },
    {
      "step": "Enrollment edges",
      "action": "Run wrong-age and missing-prerequisite cases, nine students for eight places, and a student away from school; render age 22 university case",
      "expected": "Only eight students enroll, no out-of-range enrollment or free study away from school",
      "observed": "Age 22 has school None and study 0.00; all capacity, prerequisite and attendance assertions passed"
    },
    {
      "step": "Career restrictions",
      "action": "Check manual, commercial, factory and office offers for every qualification; tick residents injected into unqualified jobs",
      "expected": "Below secondary only manual; secondary commercial; technical factory; university office; no jobs under age 18",
      "observed": "All gates passed; uneducated commercial worker loses that job and the child loses a factory job"
    },
    {
      "step": "Technical permit UI and save",
      "action": "Click Technical college in the Special menu, click a projected road-accessible clear site through CityTools, serialize the placed building",
      "expected": "One permitted college with stable type 20, generated voxel edits and preserved building after reload",
      "observed": "Permitted Technical college level 1; exactly one ground edit batch; building matches after reload"
    },
    {
      "step": "Market regression",
      "action": "Run existing native market playtest against the current classes, using qualified commercial fixtures",
      "expected": "Meal purchases and restocking conserve resources; qualified offices receive treasury wages; unfunded offices close",
      "observed": "All three native market PASS summaries and Mesa playtest PASS returned"
    }
  ],
