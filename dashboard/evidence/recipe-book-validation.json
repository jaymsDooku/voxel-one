  "commands": [
    "mvn -q -Dmaven.repo.local=target/maven-cache -Dlwjgl.natives=natives-linux -DargLine=\"-Djava.io.tmpdir=$PWD/target/tmp -Xmx768m\" -Dtest=ItemCraftingTest,CraftingTest,InventoryHudTest,RecipeMultiplayerTest,MultiplayerTest,ProtocolCompatibilityTest,SandboxIdentityTest,RoadBaseCompatibilityTest,RailwaySaveCompatibilityTest,AviationSaveCompatibilityTest,ShippingProtocolCompatibilityTest,CityFormat16RegressionTest,RailwayShippingCompatibilityTest,RailwayOwnershipCompatibilityTest,MarketEconomyTest,VoxelModelTest,ManufacturingTest test",
