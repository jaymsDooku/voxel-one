[Unit]
Description=Voxel One multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/debian/codex/voxel-one/runtime
ExecStart=/usr/bin/java -Xms64m -Xmx256m -jar /home/debian/codex/voxel-one/runtime/server.jar --bind 0.0.0.0 --port 25565 --world world.dat
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=default.target
